{
  "name": "hospital-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "concurrently -n \"api,web\" -c \"teal,cyan\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "build": "npm run build --prefix client",
    "dist": "npm run build",
    "lint": "npm run lint --prefix client"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
